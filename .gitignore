.installed.cfg
*.egg

# Testing, Coverage & Quality
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js & Angular Frontend
node_modules/
frontend/node_modules/
.angular/
frontend/.angular/
dist/
frontend/dist/
coverage/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & SQLite Files
*.db
*.sqlite
*.sqlite3
changepilot.db

# ChangePilot Temporary Files & Artifacts
temp_workspaces/
.workspaces/
*.patch
*.diff
*.png
*.jpg
*.jpeg
scratch/
.system_generated/

# Design Artifacts & Local Mockups
UI Designs/
UI Designs*/
*.fig

# Environment Variables & Secrets
.env
*.env.local
*.pem
*.key
*.cert
credentials.json
service_account.json

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
