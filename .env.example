# ChangePilot Environment Configuration
# Copy this file to .env for local overrides

# Application
APP_NAME=ChangePilot
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Google Cloud / Vertex AI Configuration
# When using ADC (Application Default Credentials):
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini API Key fallback (for testing outside GCP/Vertex)
# GEMINI_API_KEY=your-gemini-api-key

# Execution Safety Limits
MAX_REPOSITORY_SIZE_MB=100
MAX_REPOSITORY_FILES=5000
COMMAND_TIMEOUT_SECONDS=60
CLONE_TIMEOUT_SECONDS=45
WORKSPACE_BASE_DIR=temp_workspaces
